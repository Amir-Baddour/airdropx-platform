# Copy this file to .env before running docker compose up.
# None of these defaults are safe for anything beyond local/demo use.

DB_NAME=airdropx
DB_USER=airdropx
DB_PASSWORD=airdropx

# Must be at least 32 characters — JwtService refuses to start otherwise (HS256 needs a 256-bit key).
JWT_SECRET=dev-only-change-me-this-is-not-a-real-secret-32chars

CORS_ALLOWED_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
